          "field": "face",
          "type": "ordinal",
          "scale": {
            "domain": [
              "text",
              "req-drift",
              "ops",
              "build",
              "verify",
              "review",
              "vision",
              "ui-build"
            ]
          },
          "axis": {
            "title": null,
            "labelFontSize": 12.5
          }
        },
        "x": {
          "field": "v",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1.05
            ]
          },
          "axis": {
            "title": "completion (pin-pass rate)",
            "values": [
              0,
              0.25,
              0.5,
              0.75,
              1.0
            ],
            "grid": true
          }
        },
        "color": {
          "field": "tier",
          "type": "nominal",
          "scale": {
            "domain": [
              "strong",
              "mid",
              "weak"
            ],
            "range": [
              "#2e9e5b",
              "#5b8fc9",
              "#c0392b"
            ]
          },
          "legend": {
            "title": null,
            "orient": "bottom",
            "offset": 10,
            "labelExpr": "{'strong':'strong (≥0.9)','mid':'mid (0.4–0.9)','weak':'weak (<0.4)'}[datum.value]"
          }
        }
      }
